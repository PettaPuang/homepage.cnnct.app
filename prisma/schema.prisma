generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model PintuAccount {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String
  isDeveloper      Boolean   @default(false)
  active           Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accesses         PintuAccess[]
}

model PintuAccess {
  id           String       @id @default(cuid())
  accountId    String
  account      PintuAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  businessName String
  erpUrl       String
  createdAt    DateTime     @default(now())

  @@unique([accountId, erpUrl])
}
